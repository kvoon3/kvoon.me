{
  "name": "nowd",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "start": "NO_PROXY=localhost,127.0.0.1 bun src/index.ts",
    "dev": "NO_PROXY=localhost,127.0.0.1 bun --watch src/index.ts",
    "prod": "NODE_ENV=production bun src/index.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.2.10",
    "typescript": "^5.8.3"
  }
}
